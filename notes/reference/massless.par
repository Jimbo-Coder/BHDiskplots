#time::dtfac = 0.04390227762500037  #0.0281250 #0.0625

time::dtfac= 0.02253 

shift::spatial_gauge = 5
shift::hbpunc_advect_enable = 2
shift::eta = 27.33343381976734  # = 1.375/M (from https://arxiv.org/pdf/1801.02624)
# DOESN'T WORK: shift::eta = 528.7777015314991 # = 26.6/0.05 ~ 26.6/M_ADM (from https://arxiv.org/abs/2209.04454)
#                               # we also need eta < 1.5/dt
#                                 dt_coarsest = 1.25*dt_fac 
#                                 eta < 1.5/dt_coarsest = 1.5/(1.25*dt_fac)
#                         hence   dt_fac = dt/dx < 1.5/(1.25*eta) = M*1.5/(1.25*1.375) = 0.04390227762500037

#shift::eta = 3.3288948069241013

